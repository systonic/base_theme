{%
  set classes = [
    'region',
    'region-' ~ region|clean_class,
  ]
%}

{% if content %}
  {% if (tag ?? true) == true -%}
    <{{ tag_type|default('div') }}{{ attributes.addClass(classes) }}>
      {{ title_suffix.contextual_links }}
  {%- endif %}

  {{ content }}

  {% if (tag ?? true) == true -%}
    </{{ tag_type|default('div') }}>
  {%- endif %}
{% endif %}

{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

{% block views %}
  {% if (tag ?? true) == true -%}
    <{{ tag_type|default('div') }}{{ attributes.addClass(classes) }}>
  {% endif %}

  {% block title %}
    {% if view.getTitle() or title -%}
      {{ title_prefix }}
      {% if view.display_handler.pluginId == 'page' %}
        <h1>{{ view.getTitle() }}</h1>
      {% else %}
        {{ title }}
      {% endif %}
      {{ title_suffix }}
    {% endif %}
  {% endblock %}

  {% block header %}
    {% if header %}
      <header>
        {{ header }}
      </header>
    {% endif %}
  {% endblock %}

  {% if (more_on_top ?? false) == true %}
    {{ more }}
  {% endif %}

  {% block exposed %}
    {{ exposed }}
  {% endblock %}

  {{ attachment_before }}

  {% block content %}
    {% if rows -%}
      <div class="view-content">
        {{ rows }}
      </div>
    {% elseif empty -%}
      {{ empty }}
    {% endif %}
  {% endblock %}

  {{ attachment_after }}

  {% block pager %}
    {{ pager }}
  {% endblock %}

  {% if (more_on_bottom ?? true) == true %}
    {% block more %}
      {{ more }}
    {% endblock %}
  {% endif %}

  {% block footer %}
    {% if footer %}
      <footer>
        {{ footer }}
      </footer>
    {% endif %}
  {% endblock %}

  {{ feed_icons }}

  {% if (tag ?? true) == true -%}
    </{{ tag_type|default('div') }}>
  {% endif %}
{% endblock %}

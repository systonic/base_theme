{%
  set classes = [
    'view',
    'view-' ~ id|clean_class,
    'view-id-' ~ id,
    'view-display-id-' ~ display_id,
    dom_id ? 'js-view-dom-id-' ~ dom_id,
  ]
%}

<div{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  {% if view.display_handler.pluginId == 'page' %}
    <h1>{{ view.getTitle() }}</h1>
  {% else %}
    {{ title }}
  {% endif %}
  {{ title_suffix }}

  {% if header %}
    <header>
      {{ header }}
    </header>
  {% endif %}

  {% if (more_on_top ?? false) == true %}
    {{ more }}
  {% endif %}

  {{ exposed }}

  {{ attachment_before }}

  {% block content %}

    {% if rows -%}
      <div class="view-content">
        {{ rows }}
      </div>
    {% elseif empty -%}
      {{ empty }}
    {% endif %}

  {% endblock %}

  {{ attachment_after }}

  {{ pager }}

  {% if (more_on_top ?? false) == false %}
    {{ more }}
  {% endif %}

  {% if footer %}
    <footer>
      {{ footer }}
    </footer>
  {% endif %}

  {{ feed_icons }}
</div>

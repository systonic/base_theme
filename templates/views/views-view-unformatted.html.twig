{% if title %}
  <h3>{{ title }}</h3>
{% endif %}

{% for row in rows %}
  {% if default_row_class %}
    {% set row_classes = ['views-row'] %}
  {% endif %}

  {% if row.attributes is not empty or row_classes %}
    <div{{ row.attributes.addClass(row_classes) }}>
  {% endif %}
  {% block content %}
    {{- row.content -}}
  {% endblock %}
  {% if row.attributes is not empty or row_classes %}
    </div>
  {% endif %}
{% endfor %}

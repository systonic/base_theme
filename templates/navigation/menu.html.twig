{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0, _context) }}

{% macro menu_links(items, attributes, menu_level, context) %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes }}>
    {% else %}
      <ul>
    {% endif %}
    {% for item in items %}
      {%
        set classes = [
          item.is_expanded ? 'expanded',
          item.is_collapsed ? 'collapsed',
          item.in_active_trail ? 'active-trail',
        ]
      %}
      <li{{ item.attributes.addClass(classes) }}>
        {% set title %}
          {% if (context.title_wrapper ?? false) == true -%}
            <{{ context.title_type|default('span') }}>
          {% endif %}
          {{ item.title }}
          {% if (context.title_wrapper ?? false) == true -%}
            </{{ context.title_type|default('span') }}>
          {% endif %}
        {% endset %}
        {{ link(title, item.url) }}
        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}

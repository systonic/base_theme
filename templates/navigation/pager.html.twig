{% if items %}
  <ul class="pagination-list">
    {# Print first item if we are not on the first page. #}
    {#% if items.first %}
      <li class="pagination first">
        <a class="pagination-btn" href="{{ items.first.href }}" title="{{ 'Go to first page'|t }}"{{ items.first.attributes|without('href', 'title', 'class') }}>
          <span class="visually-hidden">{{ 'First page'|t }}</span>
          <span aria-hidden="true">{{ items.first.text|default('« First'|t) }}</span>
        </a>
      </li>
    {% endif %#}
    {# Print previous item if we are not on the first page. #}
    {% if items.previous %}
      <li class="pagination-prev">
        <a class="pagination-btn" href="{{ items.previous.href }}" title="{{ 'Go to previous page'|t }}" rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel', 'class')
}}>
          <svg viewBox="0 0 16 16" fill="none"><use xlink:href="#svg-arrow-small"></use></svg>
          <span class="visually-hidden">{{ 'Previous page'|t }}</span>
          <span aria-hidden="true">{{ items.previous.text|default('‹ Previous'|t) }}</span>
        </a>
      </li>
    {% endif %}
    {# Add an ellipsis if there are further previous pages. #}
    {% if ellipses.previous %}
      <li class="separator" role="presentation"></li>
    {% endif %}
    {# Now generate the actual pager piece. #}
    {% for key, item in items.pages %}
      <li class="pagination{{ current == key ? ' pagination-current' : '' }}">
        {% if current == key %}
          {% set title = 'Current page'|t %}
        {% else %}
          {% set title = 'Go to page @key'|t({'@key': key}) %}
        {% endif %}
        <a class="pagination-btn" href="{{ item.href }}" title="{{ title }}"{{ item.attributes|without('href', 'title', 'class') }}>
          <span class="visually-hidden">
            {{ current == key ? 'Current page'|t : 'Page'|t }}
          </span>
          {{- "%02d"|format(key) -}}
        </a>
      </li>
    {% endfor %}
    {# Add an ellipsis if there are further next pages. #}
    {% if ellipses.next %}
      <li class="separator" role="presentation"></li>
    {% endif %}
    {# Print next item if we are not on the last page. #}
    {% if items.next %}
      <li class="pagination-next">
        <a class="pagination-btn" href="{{ items.next.href }}" title="{{ 'Go to next page'|t }}" rel="next"{{ items.next.attributes|without('href', 'title', 'rel', 'class') }}>
          <span class="visually-hidden">{{ 'Next page'|t }}</span>
          <span aria-hidden="true">{{ items.next.text|default('Next ›'|t) }}</span>
          <svg viewBox="0 0 16 16" fill="none"><use xlink:href="#svg-arrow-small"></use></svg>
        </a>
      </li>
    {% endif %}
    {# Print last item if we are not on the last page. #}
    {#% if items.last %}
      <li class="pagination last">
        <a class="pagination-btn" href="{{ items.last.href }}" title="{{ 'Go to last page'|t }}"{{ items.last.attributes|without('href', 'title', 'class') }}>
          <span class="visually-hidden">{{ 'Last page'|t }}</span>
          <span aria-hidden="true">{{ items.last.text|default('Last »'|t) }}</span>
        </a>
      </li>
    {% endif %#}
  </ul>
{% endif %}

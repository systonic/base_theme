{% if breadcrumb %}
  <nav class="breadcrumb" role="navigation" aria-labelledby="system-breadcrumb">
    <h2 id="system-breadcrumb" class="visually-hidden">{{ 'Breadcrumb'|t }}</h2>
    {% for item in breadcrumb %}
      {% if item.url %}
        <a class="bread" href="{{ item.url }}">{{ item.text }}</a>
      {% else %}
        <span class="nolink">{{ item.text }}</span>
      {% endif %}
      {% if not loop.last %}
        <span class="separ">&gt;</span>
      {% endif %}
    {% endfor %}
  </nav>
{% endif %}
